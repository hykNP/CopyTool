#include <windows.h>

// 应用程序图标
IDI_ICON1 ICON "CopyTool.ico"

// 版本信息（可选，如果你需要的话）
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName", "CopyTool"
            VALUE "FileDescription", "CopyTool"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "CopyToolWeb.exe"
            VALUE "OriginalFilename", "CopyToolWeb.exe"
            VALUE "ProductName", "CopyTool"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END