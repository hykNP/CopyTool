#include <windows.h>

#pragma code_page(65001)

// 应用程序图标
IDI_ICON1 ICON "CopyTool.ico"

// 版本信息：文件属性「详细信息」与任务管理器「描述/公司名称」列都读这里
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0000 = 语言中性，04B0 = Unicode
        BLOCK "000004B0"
        BEGIN
            VALUE "CompanyName",      "CopyTool"
            VALUE "FileDescription",  "CopyTool"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "CopyToolWeb"
            VALUE "LegalCopyright",   "© 2026 CopyTool. All rights reserved."
            VALUE "OriginalFilename", "CopyToolWeb.exe"
            VALUE "ProductName",      "CopyTool"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0000, 0x04B0
    END
END